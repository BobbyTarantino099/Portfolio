---
import '../styles/global.css';
import { site, nav } from '../site';
import Monogram from '../components/Monogram.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;

const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Las fuentes son autoalojadas; precargarlas evita el salto de texto al
        cargar. `crossorigin` es obligatorio aunque el origen sea el mismo:
        las peticiones de fuentes van siempre en modo CORS. */}
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand">
          <Monogram />
          <span class="brand-text">
            <span class="brand-name">{site.name}</span>
            <span class="brand-role">{site.role}</span>
          </span>
        </a>

        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => {
                const current =
                  item.href === '/' ? path === '/' : path.startsWith(item.href);
                return (
                  <li>
                    <a href={item.href} aria-current={current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-identity">
          <div class="footer-brand">
            <Monogram size="sm" />
            <span>
              <span class="footer-name">{site.name}</span>
              <span class="footer-role">{site.role}</span>
            </span>
          </div>
          <p class="footer-blurb">{site.tagline}</p>
        </div>

        <nav class="footer-col" aria-label="Footer">
          <h2 class="eyebrow">Site</h2>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>

        <div class="footer-col">
          <h2 class="eyebrow">Elsewhere</h2>
          <ul>
            <li><a href={`mailto:${site.email}`}>Email</a></li>
            {site.links.linkedin && <li><a href={site.links.linkedin}>LinkedIn</a></li>}
            {site.links.github && <li><a href={site.links.github}>GitHub</a></li>}
            {site.links.cv && <li><a href={site.links.cv}>CV (PDF)</a></li>}
          </ul>
        </div>
      </div>

      {/* Colofón. En un portafolio técnico, decir con qué está hecho el sitio y
          enseñar el código se lee como criterio, no como relleno. */}
      <div class="shell colophon">
        <p>© {year} {site.name}</p>
        <p>
          Built with Astro, set in Fraunces and Inter, deployed on Cloudflare.{' '}
          <a href={site.links.source}>Source</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Contenedor común de cabecera y pie: mismo ancho máximo que el shell de las
     páginas, para que todos los bordes verticales del sitio se alineen. */
  .shell {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .site-header {
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-xl);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-s);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    color: var(--ink);
  }

  .brand-text {
    display: grid;
    line-height: 1.15;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .brand-role {
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--ink-soft);
  }

  .brand:hover .brand-name {
    color: var(--accent);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.15rem;
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }

  nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--rule);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  main {
    min-height: 60vh;
    padding-bottom: var(--space-2xl);
  }

  /* --- Pie ---------------------------------------------------------------- */

  .site-footer {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-l);
    font-size: 0.9375rem;
  }

  .footer-grid {
    display: grid;
    gap: var(--space-l) var(--space-m);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .footer-brand > span {
    display: grid;
    line-height: 1.2;
  }

  .footer-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
  }

  .footer-role {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--ink-soft);
  }

  .footer-blurb {
    margin: var(--space-2xs) 0 0;
    max-width: 34ch;
    color: var(--ink-soft);
  }

  .footer-col h2 {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-sans);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3xs);
  }

  .footer-col a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    padding-bottom: var(--space-l);
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .colophon p {
    margin: 0;
  }

  .colophon a {
    color: inherit;
    text-decoration-color: var(--rule);
  }

  .colophon a:hover {
    color: var(--accent);
  }
</style>
