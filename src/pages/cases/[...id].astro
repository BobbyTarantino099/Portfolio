---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleRail from '../../components/ArticleRail.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const dateLabel = d.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
});

/* Los metadatos viven en el rail, fuera del flujo vertical: eso es la mitad de
   lo que acorta la página. */
/* Sin `Domain`: ya aparece como eyebrow encima del titular, y en el rail cada
   línea cuesta alto que le quita sitio al índice. */
const meta = [
  { label: 'Problem type', value: d.problemType },
  { label: 'Tools', value: d.tools.join(' · ') },
  { label: 'Scale', value: d.scale },
  { label: 'Published', value: dateLabel },
  ...(d.repo ? [{ label: 'Evidence', value: 'Repository', href: d.repo }] : []),
];
---

<Base title={d.title} description={d.summary}>
  <div class="shell article-shell">
    <ArticleRail
      backHref="/"
      backLabel="Work"
      title={d.title}
      headings={headings}
      meta={meta}
    />

    <article>
      <header class="case-head">
        <p class="eyebrow">{d.domain}</p>
        <h1>{d.title}</h1>
        <p class="lede measure">{d.summary}</p>

        <div class="figure-surface hero">
          <Image
            src={d.hero}
            alt={d.heroAlt}
            widths={[640, 1024, 1440]}
            sizes="(max-width: 62rem) 100vw, 56rem"
            loading="eager"
          />
        </div>
      </header>

      <div class="case-body">
        <Content />
      </div>

      {
        /* `demonstrates` NO se renderiza aquí: el cuerpo del Markdown ya trae la
           sección "What this demonstrates" como séptima del contrato, y pintar
           ambas duplicaba el bloque entero. El campo del front-matter se queda
           como metadato para la matriz de cobertura del portafolio. */
        d.repo && (
          <footer class="case-foot">
            <p>
              Cleaning log, analysis scripts and the full case record are in the{' '}
              <a href={d.repo}>case repository</a>.
            </p>
          </footer>
        )
      }
    </article>
  </div>
</Base>

<style>
  .case-head {
    margin-bottom: var(--space-xl);
  }

  .case-head h1 {
    margin: var(--space-2xs) 0 var(--space-m);
    max-width: 20ch;
  }

  .case-head .lede {
    margin-bottom: var(--space-l);
  }

  /* --- Cuerpo del Markdown -------------------------------------------------
     El contenido lo renderiza <Content />, así que sus elementos no llevan el
     atributo de ámbito de Astro: hay que alcanzarlos con :global().
     El texto mantiene su medida; figuras, tablas y código ocupan todo el ancho
     de la columna de contenido, que es bastante más ancha. */

  .case-body :global(p),
  .case-body :global(ul),
  .case-body :global(ol),
  .case-body :global(h2),
  .case-body :global(h3),
  .case-body :global(blockquote) {
    max-width: var(--measure);
  }

  .case-body :global(> *:first-child) {
    margin-top: 0;
  }

  /* Astro envuelve las imágenes de Markdown en un <p>, así que el lienzo blanco
     va al párrafo contenedor — y ese párrafo sí ocupa el ancho completo. */
  .case-body :global(p:has(> img)) {
    max-width: none;
    background: var(--figure-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--figure-pad);
    margin-block: var(--space-l);
  }

  /* Las tablas de Markdown no traen envoltorio y, sin él, no pueden encogerse
     por debajo del ancho mínimo de sus columnas: en móvil desbordaban la página
     (medido: 103 px). Convertirlas en bloque les da un contenedor que absorbe el
     scroll horizontal. Un plugin de rehype sería más limpio, pero Astro 7 usa
     Sätteri y habilitarlos obligaría a instalar el procesador antiguo entero. */
  .case-body :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
  }

  .case-foot {
    margin-top: var(--space-xl);
  }

  .case-foot p {
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0;
    max-width: var(--measure);
  }
</style>
