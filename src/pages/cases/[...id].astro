---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const dateLabel = d.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
});
---

<Base title={d.title} description={d.summary}>
  <article>
    <header class="content-grid case-head">
      <p class="eyebrow">
        <a href="/">Work</a> <span aria-hidden="true">/</span> {d.domain}
      </p>

      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      <div class="figure-surface hero wide">
        <Image
          src={d.hero}
          alt={d.heroAlt}
          widths={[640, 1024, 1440]}
          sizes="(max-width: 64rem) 100vw, 60rem"
          loading="eager"
        />
      </div>

      <dl class="meta wide">
        <div><dt>Problem type</dt><dd>{d.problemType}</dd></div>
        <div><dt>Domain</dt><dd>{d.domain}</dd></div>
        <div><dt>Tools</dt><dd>{d.tools.join(' · ')}</dd></div>
        <div><dt>Scale</dt><dd>{d.scale}</dd></div>
        <div><dt>Published</dt><dd>{dateLabel}</dd></div>
        <div>
          <dt>Evidence</dt>
          <dd>
            {
              d.repo ? (
                <a href={d.repo}>Repository</a>
              ) : (
                <span class="muted">Not published yet</span>
              )
            }
          </dd>
        </div>
      </dl>
    </header>

    <div class="content-grid case-body">
      <Content />
    </div>

    {
      /* `demonstrates` NO se renderiza aquí: el cuerpo del Markdown ya trae la
         sección "What this demonstrates" como séptima del contrato, y pintar
         ambas duplicaba el bloque entero. El campo del front-matter se queda
         como metadato para la matriz de cobertura del portafolio. */
      d.repo && (
        <footer class="content-grid case-foot">
          <p>
            Cleaning log, analysis scripts and the full case record are in the{' '}
            <a href={d.repo}>case repository</a>.
          </p>
        </footer>
      )
    }
  </article>
</Base>

<style>
  .case-head {
    margin-bottom: var(--space-xl);
  }

  .eyebrow a {
    color: inherit;
    text-decoration-color: var(--rule);
  }

  .case-head h1 {
    margin: var(--space-s) 0 var(--space-m);
    max-width: 21ch;
  }

  .case-head .lede {
    margin-bottom: var(--space-l);
  }

  .hero {
    margin-bottom: var(--space-m);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-s) var(--space-m);
    margin: 0;
    padding-block: var(--space-s);
    border-block: 1px solid var(--rule);
  }

  .meta dt {
    font-size: 0.7rem;
    font-weight: 550;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--ink-soft);
    margin-bottom: var(--space-3xs);
  }

  .meta dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  /* --- Cuerpo del Markdown -------------------------------------------------
     El contenido lo renderiza <Content />, así que sus elementos no llevan el
     atributo de ámbito de Astro: hay que alcanzarlos con :global().
     Las figuras, tablas y bloques de código escapan a la columna ancha; el
     texto se queda en la medida de lectura. */

  .case-body :global(> *:first-child) {
    margin-top: 0;
  }

  /* Astro envuelve las imágenes de Markdown en un <p>, así que el lienzo
     blanco se aplica al párrafo contenedor. */
  .case-body :global(p:has(> img)) {
    grid-column: wide;
    background: var(--figure-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--figure-pad);
    margin-block: var(--space-l);
  }

  /* Las tablas de Markdown no traen envoltorio y, siendo hijas directas de la
     rejilla, no pueden encogerse por debajo del ancho mínimo de sus columnas:
     en móvil desbordaban la página entera (medido: 103 px). Convertirlas en
     bloque les da un contenedor que absorbe el scroll horizontal.
     Un plugin de rehype sería más limpio, pero Astro 7 usa Sätteri como
     procesador de Markdown y habilitarlos obligaría a instalar el procesador
     antiguo entero. */
  .case-body :global(table) {
    grid-column: wide;
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
  }

  .case-body :global(pre) {
    grid-column: wide;
  }

  .case-foot {
    margin-top: var(--space-xl);
  }

  .case-foot p {
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0;
  }
</style>
