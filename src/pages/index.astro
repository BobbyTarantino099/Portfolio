---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { site } from '../site';

const cases = (await getCollection('cases')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

/* El caso destacado más reciente encabeza la página; el resto va en filas
   compactas. Una lista uniforme no tiene punto focal. */
const featured = cases.find((c) => c.data.featured) ?? cases[0];
const rest = cases.filter((c) => c !== featured);
---

<Base title={site.name}>
  <section class="content-grid intro">
    {/* La portada arranca en el borde ancho, el mismo que las tarjetas y el
        rótulo de sección: un héroe indentado respecto a lo que viene debajo se
        lee como desalineado, no como deliberado. */}
    <div class="wide intro-inner">
      <p class="eyebrow">{site.name} — Data analyst</p>
      <h1>{site.tagline}</h1>
      <p class="lede">
        Each case starts from a decision someone had to make, runs on real data with its cleaning
        documented step by step, and ends in recommendations that state their own limits. The full
        evidence — logs, notebooks, reconciliation counts — lives in each case's repository.
      </p>
    </div>
  </section>

  <section class="content-grid work" aria-labelledby="work">
    <p class="eyebrow section-label" id="work">Selected work</p>

    {featured && <div class="wide featured-slot"><CaseCard entry={featured} variant="featured" /></div>}

    {
      rest.length > 0 && (
        <div class="wide rest">
          {rest.map((entry) => (
            <CaseCard entry={entry} variant="compact" />
          ))}
        </div>
      )
    }

    {cases.length === 0 && <p class="muted">No cases published yet.</p>}
  </section>
</Base>

<style>
  .intro {
    margin-bottom: var(--space-2xl);
  }

  .intro h1 {
    margin: var(--space-xs) 0 var(--space-m);
    max-width: 17ch;
  }

  .intro .lede {
    max-width: 54ch;
  }

  .section-label {
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-l);
  }

  /* El rótulo de sección se alinea con las tarjetas, no con la columna de
     texto: marca el ancho del bloque que encabeza. */
  .work > .section-label {
    grid-column: wide;
  }

  .rest {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
</style>
