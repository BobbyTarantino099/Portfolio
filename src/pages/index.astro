---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { site } from '../site';

/* `featured` ya no agranda la tarjeta: todas son iguales. Solo decide el orden,
   y dentro de cada grupo mandan las más recientes. */
const cases = (await getCollection('cases')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const latestNote = notes[0];
---

<Base title={site.name}>
  <section class="shell intro">
    <h1>{site.tagline}</h1>
    <p class="lede">
      Each case starts from a decision someone had to make, runs on real data with its cleaning
      documented step by step, and ends in recommendations that state their own limits. The full
      evidence — logs, notebooks, reconciliation counts — lives in each case's repository.
    </p>
  </section>

  <section class="shell work" aria-labelledby="work">
    <div class="section-head">
      <h2 class="eyebrow" id="work">Selected work</h2>
      <p class="eyebrow count">{cases.length} {cases.length === 1 ? 'case' : 'cases'}</p>
    </div>

    {
      cases.length === 0 ? (
        <p class="muted">No cases published yet.</p>
      ) : (
        <div class="card-grid">
          {cases.map((entry) => <CaseCard entry={entry} />)}
        </div>
      )
    }
  </section>

  {
    latestNote && (
      <section class="shell notes-teaser" aria-labelledby="latest-note">
        <div class="section-head">
          <h2 class="eyebrow" id="latest-note">Latest note</h2>
          <p class="eyebrow"><a href="/notes/">All notes →</a></p>
        </div>
        <a href={`/notes/${latestNote.id}/`} class="note-link">
          <span class="note-title">{latestNote.data.title}</span>
          <span class="note-summary">{latestNote.data.summary}</span>
        </a>
      </section>
    )
  }
</Base>

<style>
  .intro {
    margin-bottom: var(--space-2xl);
  }

  .intro h1 {
    margin: 0 0 var(--space-m);
    max-width: 17ch;
  }

  .intro .lede {
    max-width: 54ch;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-l);
  }

  .section-head h2 {
    margin: 0;
    font-family: var(--font-sans);
  }

  .section-head a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--accent);
  }

  .count {
    color: var(--ink-soft);
  }

  /* `auto-fill` en vez de `auto-fit`: con auto-fit una sola tarjeta se estiraría
     a todo el ancho y parecería un error de maquetación. Así conserva su tamaño
     y la rejilla se llena sola conforme entren más casos. */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 24rem));
    gap: var(--space-m);
  }

  .notes-teaser {
    margin-top: var(--space-2xl);
  }

  .note-link {
    display: grid;
    gap: var(--space-3xs);
    text-decoration: none;
    max-width: var(--measure);
  }

  .note-title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }

  .note-link:hover .note-title {
    color: var(--accent);
  }

  .note-summary {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
