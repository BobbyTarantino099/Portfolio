---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.png';
import { site } from '../site';

/*
 * Bio escrita a partir del CV de Juan (Connext Global Solutions, Petrozones,
 * UNAB) y de sus respuestas: busca remoto internacional, ya trabaja con datos,
 * le atraen negocio y producto, y quiere que se le recuerde por traducir datos
 * a decisiones. Nada aquí está inventado — todo sale del CV o de lo que dijo.
 *
 * Lo que SÍ deja fuera a propósito: el objetivo del CV apunta a un puesto
 * concreto en banca local, y en el sitio dijo que busca remoto internacional.
 * Manda lo segundo.
 */

const tools = {
  'Day to day': ['Python', 'SQL', 'Power BI', 'Advanced Excel'],
  'In this portfolio': ['pandas', 'matplotlib', 'Astro'],
};

const facts = [
  { label: 'Based in', value: 'Bucaramanga, Colombia (UTC−5)' },
  { label: 'Languages', value: 'Spanish (native), English (C1)' },
  { label: 'Studying', value: 'Systems Engineering, UNAB' },
];
---

<Base
  title="About"
  description={`${site.name} — ${site.role} working on financial data. ${site.tagline}`}
>
  <div class="shell about">
    <header class="about-head">
      <Image
        src={portrait}
        alt={`Portrait of ${site.name}`}
        widths={[160, 320]}
        sizes="10rem"
        class="portrait"
        loading="eager"
      />

      <div>
        <p class="eyebrow">About</p>
        <h1>{site.name}</h1>
        <p class="role">{site.role} · Open to remote roles</p>
      </div>
    </header>

    <div class="about-body">
      <div class="bio measure">
        <p class="lede">
          I&rsquo;ve spent the last few years turning financial data into things people can decide
          with. I build these case studies to show how I actually think — not just what tools I
          can name.
        </p>

        <p>
          I&rsquo;m a data analyst at <strong>Connext Global Solutions</strong>, working on
          international banking portfolios: automating financial statements and cash-flow
          reporting, building Power BI dashboards that track quarterly KPIs and covenant
          compliance for stakeholders across several regions, and maintaining the Python and Azure
          SQL pipelines underneath them. Before that I spent nearly three years at{' '}
          <strong>Petrozones</strong> writing ETL scripts and building dashboards for operational
          data.
        </p>

        <p>
          That work is where I learned the part I care most about: the last mile. Plenty of
          analyses stop at an observation — a correlation, a chart, a number that moved. What
          takes work is turning it into something a person can act on, with the limits of the
          evidence stated plainly. When a covenant report goes to a stakeholder three timezones
          away, it has to be right <em>and</em> it has to be readable without you in the room.
        </p>

        <p>
          The case studies here are where I practise that in public, on questions nobody assigned
          me. Each one starts from a decision someone had to make, documents every cleaning step
          so it can be re-run from the raw file, and ends in recommendations that say what the
          data supports and what it doesn&rsquo;t. The <a href="/method/">method</a> behind them
          is written down too.
        </p>

        <p>
          I&rsquo;m looking for <strong>remote data analyst roles</strong> with teams that value a
          documented process. The fastest way to judge whether that&rsquo;s useful to you is to
          read a case.
        </p>
      </div>

      <aside class="about-side">
        <section>
          <h2 class="eyebrow">Tools</h2>
          <dl class="tools">
            {
              Object.entries(tools).map(([label, items]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>
                    <ul class="tags">
                      {items.map((t) => <li class="tag">{t}</li>)}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section>
          <h2 class="eyebrow">Details</h2>
          <dl class="facts">
            {
              facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section>
          <h2 class="eyebrow">Get in touch</h2>
          <ul class="contact">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {site.links.linkedin && <li><a href={site.links.linkedin}>LinkedIn</a></li>}
            {site.links.github && <li><a href={site.links.github}>GitHub</a></li>}
            {site.links.cv && <li><a href={site.links.cv}>Download CV (PDF)</a></li>}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .about-head {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .portrait {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule);
    flex: none;
  }

  .about-head h1 {
    margin: var(--space-3xs) 0;
  }

  .role {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .about-body {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .about-body {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .about-side {
    display: grid;
    gap: var(--space-l);
  }

  .about-side h2 {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-sans);
    padding-bottom: var(--space-3xs);
    border-bottom: 1px solid var(--rule);
  }

  .tools,
  .facts {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .tools dt,
  .facts dt {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-3xs);
  }

  .tools dd,
  .facts dd {
    margin: 0;
  }

  .facts dd {
    font-size: 0.9375rem;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3xs);
    font-size: 0.9375rem;
  }
</style>
