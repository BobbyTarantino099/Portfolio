---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import portrait from '../assets/portrait.png';
import { site } from '../site';

/*
 * Todo el contenido sale del CV de Juan y de sus respuestas. Nada inventado.
 *
 * El hueco entre Petrozones (dic 2023) y Connext (oct 2024) queda a la vista con
 * las fechas reales: decisión suya. Nueve meses no llaman la atención, y falsear
 * fechas sí es un problema si alguien contrasta con LinkedIn.
 */

const tools = {
  'Day to day': ['Python', 'SQL', 'Power BI', 'Advanced Excel'],
  'In this portfolio': ['pandas', 'matplotlib', 'Astro'],
};

const facts = [
  { label: 'Based in', value: 'Bucaramanga, Colombia (UTC−5)' },
  { label: 'Languages', value: 'Spanish (native), English (C1)' },
  { label: 'Certifications', value: 'Google Data Analytics · Financial Modeling (Excel) · Google Cloud Essentials' },
];
---

<Base
  title="About"
  description={`${site.name} — ${site.role} working on financial data. ${site.tagline}`}
>
  <div class="shell about">
    <header class="about-head">
      <Image
        src={portrait}
        alt={`Portrait of ${site.name}`}
        widths={[160, 320]}
        sizes="10rem"
        class="portrait"
        loading="eager"
      />

      <div>
        <p class="eyebrow">About</p>
        <h1>{site.name}</h1>
        <p class="role">{site.role} · Open to remote roles</p>
      </div>
    </header>

    <div class="about-body">
      <div class="bio">
        <p class="lede measure">
          I&rsquo;m a data analyst working on international banking portfolios, where the job is
          usually to make a number both correct and readable by someone three timezones away. The
          case studies on this site are where I practise that in public, on questions nobody
          assigned me.
        </p>

        <section class="experience" aria-labelledby="experience">
          <h2 class="eyebrow" id="experience">Experience</h2>
          <p class="hint">Expand a role to see what I built there.</p>

          <ol class="timeline">
            <TimelineEntry
              period="Oct 2024 — Present"
              role="Data Analyst"
              org="Connext Global Solutions"
              achievement="Automating financial reporting and covenant monitoring across international banking portfolios."
              stack={['Python', 'Azure SQL', 'Power BI (DAX)', 'Advanced Excel', 'Power Query']}
              open
            >
              <p>
                I automate the reporting layer for cross-border lending portfolios: financial
                statements, waterfall models and cash-flow reports that used to be assembled by
                hand every cycle.
              </p>
              <p>
                On top of that sit the executive dashboards — quarterly KPIs, payment distribution
                and covenant compliance — that stakeholders in several regions read without me in
                the room. Underneath, Python scripts and an Azure SQL database ingest and transform
                the origination data, and the pipelines have to keep that data intact end to end.
              </p>
              <p>
                Part of the work is watching contractual obligations and payment allocations to
                cross-border originators, which is a good school for a habit I use everywhere: the
                number has to survive someone checking it.
              </p>
            </TimelineEntry>

            <TimelineEntry
              period="Apr 2021 — Dec 2023"
              role="Data Analyst"
              org="Petrozones"
              achievement="Built the ETL and reporting layer for operational data, cutting manual entry in half."
              stack={['Python', 'MySQL', 'Power BI', 'Advanced Excel']}
            >
              <p>
                I wrote the Python ETL that pulled data from APIs and CSV files, which removed
                about half of the manual entry the team was doing. I also designed and tuned the
                MySQL schemas and queries behind it.
              </p>
              <p>
                The output was a set of Power BI dashboards combining several sources, plus weekly
                business reports in Excel for operations and management. It was my first real
                lesson in the difference between a report that exists and a report someone
                actually uses.
              </p>
            </TimelineEntry>

            <TimelineEntry
              period="Expected Jul 2026"
              role="Systems Engineering"
              org="Universidad Autónoma de Bucaramanga"
              achievement="Finishing the degree alongside full-time analyst work."
            >
              <p>
                I&rsquo;ve been studying Systems and Computing Engineering while working full time.
                It is where the engineering side of this comes from — databases, pipelines, and the
                habit of treating an analysis as something that has to run again tomorrow.
              </p>
            </TimelineEntry>
          </ol>
        </section>

        <p class="closing measure">
          I&rsquo;m looking for <strong>remote data analyst roles</strong> with teams that value a
          documented process. The fastest way to judge whether that&rsquo;s useful to you is to
          read a case — the <a href="/method/">method</a> behind them is written down too.
        </p>
      </div>

      <aside class="about-side">
        <section>
          <h2 class="eyebrow">Tools</h2>
          <dl class="tools">
            {
              Object.entries(tools).map(([label, items]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>
                    <ul class="tags">
                      {items.map((t) => <li class="tag">{t}</li>)}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section>
          <h2 class="eyebrow">Details</h2>
          <dl class="facts">
            {
              facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section>
          <h2 class="eyebrow">Get in touch</h2>
          <ul class="contact">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {site.links.linkedin && <li><a href={site.links.linkedin}>LinkedIn</a></li>}
            {site.links.github && <li><a href={site.links.github}>GitHub</a></li>}
            {site.links.cv && <li><a href={site.links.cv}>Download CV (PDF)</a></li>}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .about-head {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .portrait {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule);
    flex: none;
  }

  .about-head h1 {
    margin: var(--space-3xs) 0;
  }

  .role {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .about-body {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .about-body {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  /* --- Experiencia --------------------------------------------------------- */

  .experience {
    margin-top: var(--space-2xl);
  }

  .experience h2 {
    margin: 0;
    font-family: var(--font-sans);
    padding-bottom: var(--space-3xs);
    border-bottom: 1px solid var(--rule);
  }

  .hint {
    margin: var(--space-2xs) 0 var(--space-l);
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  /* La línea vertical de la que cuelgan los puntos de cada entrada. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-2xs);
    border-left: 1px solid var(--rule);
  }

  .timeline > :global(.entry:last-child) {
    padding-bottom: 0;
  }

  .closing {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  /* --- Barra lateral ------------------------------------------------------- */

  .about-side {
    display: grid;
    gap: var(--space-l);
  }

  .about-side h2 {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-sans);
    padding-bottom: var(--space-3xs);
    border-bottom: 1px solid var(--rule);
  }

  .tools,
  .facts {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .tools dt,
  .facts dt {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-3xs);
  }

  .tools dd,
  .facts dd {
    margin: 0;
  }

  .facts dd {
    font-size: 0.9375rem;
  }

  .contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3xs);
    font-size: 0.9375rem;
  }
</style>
