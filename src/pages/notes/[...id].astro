---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleRail from '../../components/ArticleRail.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const meta = [
  {
    label: 'Published',
    value: d.date.toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }),
  },
  ...(d.tags.length > 0 ? [{ label: 'Tags', value: d.tags.join(' · ') }] : []),
];
---

<Base title={d.title} description={d.summary}>
  <div class="shell article-shell">
    <ArticleRail
      backHref="/notes/"
      backLabel="Notes"
      title={d.title}
      headings={headings}
      meta={meta}
    />

    <article>
      <header class="note-head">
        <h1>{d.title}</h1>
        <p class="lede measure">{d.summary}</p>
      </header>

      <div class="note-body">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  .note-head {
    margin-bottom: var(--space-l);
  }

  .note-head h1 {
    margin: 0 0 var(--space-m);
    max-width: 22ch;
  }

  /* El contenido viene de <Content />, sin atributo de ámbito: :global(). */
  .note-body :global(p),
  .note-body :global(ul),
  .note-body :global(ol),
  .note-body :global(h2),
  .note-body :global(h3),
  .note-body :global(blockquote) {
    max-width: var(--measure);
  }

  .note-body :global(> *:first-child) {
    margin-top: 0;
  }

  .note-body :global(p:has(> img)) {
    max-width: none;
    background: var(--figure-bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--figure-pad);
    margin-block: var(--space-l);
  }

  /* Mismo motivo que en la página de caso: sin envoltorio, una tabla de
     Markdown desborda la página en móvil. */
  .note-body :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
