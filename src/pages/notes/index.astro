---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base
  title="Notes"
  description="Short notes on data analysis: things learned mid-case, techniques worth writing down."
>
  <div class="prose">
    <h1>Notes</h1>
    <p>
      Short pieces that are not full case studies: something learned mid-analysis, a technique
      worth writing down, a chart that needed a comment. Cases take weeks; these do not.
    </p>
  </div>

  {
    notes.length === 0 ? (
      <p class="muted">No notes yet.</p>
    ) : (
      <ul class="note-list">
        {notes.map((note) => (
          <li>
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            <p class="muted">{note.data.summary}</p>
            <time datetime={note.data.date.toISOString()}>
              {note.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' })}
            </time>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .note-list {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 2rem;
    max-width: var(--measure);
  }

  .note-list > li {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .note-list > li:last-child {
    border-bottom: 0;
  }

  .note-list a {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .note-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .note-list p {
    margin: 0.4rem 0 0.5rem;
  }

  time {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
