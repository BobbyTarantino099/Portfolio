---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
  variant?: 'featured' | 'compact';
}

const { entry, variant = 'compact' } = Astro.props;
const { title, summary, hero, heroAlt, tools, scale, domain } = entry.data;
const href = `/cases/${entry.id}/`;
---

{
  variant === 'featured' ? (
    <article class="card card-featured">
      <p class="eyebrow">{domain}</p>

      {/* El enlace del titular se estira sobre toda la tarjeta con ::after, así
          la tarjeta entera es clicable sin duplicar enlaces en el árbol de
          accesibilidad. */}
      <h2><a href={href}>{title}</a></h2>

      <p class="summary">{summary}</p>

      <ul class="tags">
        {tools.map((tool) => <li class="tag">{tool}</li>)}
        <li class="tag">{scale}</li>
      </ul>

      <div class="figure-surface card-media">
        <Image
          src={hero}
          alt={heroAlt}
          widths={[640, 960, 1280]}
          sizes="(max-width: 60rem) 100vw, 56rem"
          loading="eager"
        />
      </div>
    </article>
  ) : (
    <article class="card card-compact">
      <div class="compact-text">
        <p class="eyebrow">{domain}</p>
        <h3><a href={href}>{title}</a></h3>
        <p class="summary">{summary}</p>
        <ul class="tags">
          {tools.map((tool) => <li class="tag">{tool}</li>)}
        </ul>
      </div>

      <div class="figure-surface compact-media">
        <Image src={hero} alt="" widths={[280, 560]} sizes="14rem" loading="lazy" />
      </div>
    </article>
  )
}

<style>
  .card {
    position: relative;
  }

  .card a {
    text-decoration: none;
    color: inherit;
  }

  /* Toda la tarjeta es zona de clic. */
  .card :where(h2, h3) a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card :where(h2, h3) a:hover {
    color: var(--accent);
  }

  /* --- Destacada --------------------------------------------------------- */

  .card-featured h2 {
    margin: var(--space-2xs) 0 var(--space-s);
    max-width: 20ch;
    font-size: clamp(1.9rem, 1.4rem + 2.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .card-featured .summary {
    max-width: 54ch;
    font-size: 1.0625rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-s);
  }

  .card-featured .tags {
    margin-bottom: var(--space-m);
  }

  .card-media {
    transition: border-color 160ms ease;
  }

  .card-featured:hover .card-media {
    border-color: var(--accent);
  }

  /* --- Compacta ---------------------------------------------------------- */

  .card-compact {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
    align-items: start;
  }

  @media (min-width: 44rem) {
    .card-compact {
      grid-template-columns: minmax(0, 1fr) 14rem;
    }
  }

  .card-compact h3 {
    margin: var(--space-3xs) 0 var(--space-2xs);
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .card-compact .summary {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin-bottom: var(--space-2xs);
  }

  .compact-media {
    padding: 0.4rem;
  }
</style>
